# Сгенерировать окружение и пароль: python manage.py init-admin
SECRET_KEY=
# 1 — локальный HTTP-предпросмотр, индексация запрещена; 0 — HTTPS production.
LOCAL_PREVIEW=1
PORT=5001
# Альтернатива init-admin: пароль окружения от 16 символов при первом запуске.
# ADMIN_PASSWORD=
# STORAGE_DIR=/srv/roman/storage
# SITE_DB=/srv/roman/storage/site.db
# PASSWORD_FILE=/srv/roman/storage/password_hash.txt
# CONTENT_FILE=/srv/roman/storage/content.json
